{
  "name": "huide-vision-mcp",
  "version": "0.1.0",
  "description": "A remote MCP server that gives text-only developer agents screenshot understanding.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "huide-vision-mcp": "dist/local-adapter.js"
  },
  "files": [
    "dist/local-adapter.js",
    "dist/image-tiler.js",
    "pi",
    "src/local-adapter.ts",
    "src/image-tiler.ts",
    "README.md",
    "client.env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./pi/huide-vision-bridge.ts"
    ]
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:local": "tsc -p tsconfig.local.json",
    "prepack": "npm run build:local",
    "prepublishOnly": "npm run check && npm test",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
